{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/bio",                         "destination": "/bio" },
    { "source": "/links",                        "destination": "/bio" },
    { "source": "/configurador",                 "destination": "/configurador_cotizacion" },
    { "source": "/configurator",                 "destination": "/configurador_cotizacion" },
    { "source": "/quote",                        "destination": "/configurador_cotizacion" },
    { "source": "/cotizar",                      "destination": "/configurador_cotizacion" },
    { "source": "/cotizacion",                   "destination": "/configurador_cotizacion" },
    { "source": "/ficha",                        "destination": "/ficha_tecnica" },
    { "source": "/fichas",                       "destination": "/ficha_tecnica" },
    { "source": "/ficha/:slug",                  "destination": "/ficha_tecnica?id=:slug" },
    { "source": "/equipos/:slug",                "destination": "/ficha_tecnica?id=:slug" },
    { "source": "/maquinaria/:slug",             "destination": "/ficha_tecnica?id=:slug" },
    { "source": "/product/:slug",                "destination": "/ficha_tecnica?id=:slug" }
  ]
}
